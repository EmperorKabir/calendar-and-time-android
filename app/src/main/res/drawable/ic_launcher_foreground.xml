<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground. Every mask shape (square, rounded square, circle,
    squircle, teardrop) crops the 108dp canvas differently, and only the centre 66dp
    circle is guaranteed to survive. All artwork here sits inside a 46dp square
    centred at 54,54, whose worst corner is 32.5dp from centre, so nothing clips.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Page -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,31 h30 a8,8 0 0 1 8,8 v30 a8,8 0 0 1 -8,8 h-30 a8,8 0 0 1 -8,-8 v-30 a8,8 0 0 1 8,-8 z" />

    <!-- Header band, square along its lower edge so it reads as a calendar spine -->
    <path
        android:fillColor="#1A73E8"
        android:pathData="M39,31 h30 a8,8 0 0 1 8,8 v6 h-46 v-6 a8,8 0 0 1 8,-8 z" />

    <!-- Day grid: three columns, two rows -->
    <path
        android:fillColor="#1A73E8"
        android:pathData="M39,53 h7 v7 h-7 z M50.5,53 h7 v7 h-7 z M62,53 h7 v7 h-7 z" />
    <path
        android:fillColor="#1A73E8"
        android:pathData="M39,64 h7 v7 h-7 z M50.5,64 h7 v7 h-7 z" />
    <!-- Today, filled solid to give the mark a focal point -->
    <path
        android:fillColor="#E8710A"
        android:pathData="M62,64 h7 v7 h-7 z" />
</vector>
