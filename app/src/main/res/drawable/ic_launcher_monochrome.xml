<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed icon layer. Android tints this a single colour, so it must read as a
    silhouette: the page is an outline rather than a fill, or the whole mark would
    become a solid block. Same safe zone as the foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Page outline -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,31 h30 a8,8 0 0 1 8,8 v30 a8,8 0 0 1 -8,8 h-30 a8,8 0 0 1 -8,-8 v-30 a8,8 0 0 1 8,-8 z M39,36 a3,3 0 0 0 -3,3 v30 a3,3 0 0 0 3,3 h30 a3,3 0 0 0 3,-3 v-30 a3,3 0 0 0 -3,-3 z" />

    <!-- Header band -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,39 a3,3 0 0 1 3,-3 h30 a3,3 0 0 1 3,3 v6 h-36 z" />

    <!-- Day grid -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,53 h7 v7 h-7 z M50.5,53 h7 v7 h-7 z M62,53 h7 v7 h-7 z M39,64 h7 v7 h-7 z M50.5,64 h7 v7 h-7 z M62,64 h7 v7 h-7 z" />
</vector>
